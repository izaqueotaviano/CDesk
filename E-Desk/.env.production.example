# Produção — copie para .env NO SERVIDOR (fora do repositório, 0600, dono do
# usuário que roda a aplicação). Nada daqui entra no git.

DJANGO_SETTINGS_MODULE=config.settings.prod
# 64+ caracteres aleatórios: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# só os hosts reais, sem curinga
DJANGO_ALLOWED_HOSTS=app.exemplo.com.br
# caminho do admin fora do óbvio (o nginx tem o mesmo caminho na zona estrita)
DJANGO_ADMIN_URL=painel-interno-x7k2
DJANGO_LOG_LEVEL=INFO
# quem recebe e-mail de erro 500 ("Nome:email", separados por vírgula)
DJANGO_ADMINS=Izaque:izaque@exemplo.com.br
API_DOCS_ENABLED=0

# --- Banco: o papel de APLICAÇÃO (DML), TLS verificado ---------------------
DATABASE_URL=postgres://resolv_app:TROQUE@10.0.0.5:5432/resolv
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/resolv/pg-ca.crt
# usado SÓ pelo passo de migrate do deploy (papel dono do schema)
DATABASE_URL_MIGRATE=postgres://resolv_owner:TROQUE@10.0.0.5:5432/resolv
DB_CONN_MAX_AGE=60

# --- Redis com senha (requirepass) e, se atravessar rede, TLS (rediss://) ----
REDIS_URL=redis://:TROQUE@10.0.0.6:6379

# --- Origens (SPA e API no mesmo domínio: só o próprio) ---------------------
CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br
CSRF_TRUSTED_ORIGINS=https://app.exemplo.com.br
SITE_URL=https://app.exemplo.com.br

# --- Força bruta ------------------------------------------------------------
AXES_ENABLED=1
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Anexos ------------------------------------------------------------------
MEDIA_ROOT=/var/lib/resolv/media   # fora do webroot, 0750, dono da aplicação
CLAMAV_ENABLED=1
CLAMAV_HOST=127.0.0.1
ATTACHMENT_BLOCK_ON_SCAN_ERROR=1

# --- E-mail ------------------------------------------------------------------
EMAIL_HOST=smtp.exemplo.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Resolv <no-reply@exemplo.com.br>
SUPPORT_NOTIFICATION_EMAIL=suporte@exemplo.com.br

# --- Retenção (D18): só desligue o dry-run depois de revisar um relatório ----
RETENTION_DRY_RUN=1
BACKUP_ROTATION_DAYS=30
