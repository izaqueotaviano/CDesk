# Copie para .env e ajuste. NUNCA versione o .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-de-50-caracteres
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Banco ---
DATABASE_URL=postgres://resolv:resolv@db:5432/resolv
POSTGRES_DB=resolv
POSTGRES_USER=resolv
POSTGRES_PASSWORD=resolv

# --- Redis (base sem índice de db; 1=cache 2=channels 3=broker 4=result) ---
REDIS_URL=redis://redis:6379

# --- Origem do frontend ---
# A autenticação é por SESSÃO (cookie) + CSRF, então a origem de onde o front
# roda precisa estar nas DUAS listas abaixo. Os valores de fábrica cobrem as
# portas usuais do Vite; troque pela porta/domínio do seu front.
#
# O sintoma de esquecer isso engana: o login funciona e todo o resto dá 403 —
# o DRF só cobra CSRF de requisição já AUTENTICADA.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# --- Compartilhar com outra pessoa (./resolv compartilhar) ---
# Deixe em branco no uso normal. Para rede local, não precisa preencher nada
# aqui à mão: `./resolv compartilhar` descobre seu IP sozinho e grava esta
# variável e as duas de CORS/CSRF acima. Preencha manualmente só pra um túnel
# (Cloudflare etc.), que o script não sabe descobrir sozinho.
#
# DJANGO_ALLOWED_HOSTS_EXTRA: o Host que o navegador de quem testa vai mandar.
#   Túnel:       DJANGO_ALLOWED_HOSTS_EXTRA=SEU-LINK.trycloudflare.com
# CORS_ALLOWED_ORIGINS/CSRF_TRUSTED_ORIGINS: a ORIGEM completa — some a sua
# ao final da lista acima em vez de substituir (senão a origem local para de
# logar). Ex.: ...,https://SEU-LINK.trycloudflare.com
DJANGO_ALLOWED_HOSTS_EXTRA=

# --- Documentação do contrato fora de DEBUG ---
# Liga /api/schema/ e /api/docs/ num ambiente que não é DEBUG (homologação,
# por exemplo). Deixe DESLIGADO em produção: o schema descreve todos os
# endpoints, inclusive os administrativos.
API_DOCS_ENABLED=0

# --- Código fixo do 2FA (SÓ desenvolvimento) ---
# O 2FA é obrigatório em todo login. Em dev, este código entra em qualquer
# conta, para não ter de caçar seis dígitos no terminal a cada entrada.
#
# Ele SÓ funciona com DEBUG=True (a checagem está em
# apps/accounts/views.py::_codigo_mestre_de_dev) e a variável só é lida por
# config/settings/dev.py — produção carrega config.settings.prod, que não a
# conhece. Deixe vazio para exigir o código real mesmo em desenvolvimento.
TWO_FACTOR_DEV_CODE=123456

# --- Google OAuth (login dos usuários internos) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=suaempresa.com.br

# --- E-mail ---
DEFAULT_FROM_EMAIL=Resolv <no-reply@suaempresa.com.br>
EMAIL_REPLY_TO=no-reply@suaempresa.com.br
SUPPORT_NOTIFICATION_EMAIL=suporte@suaempresa.com.br
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Endereço público da aplicação — base dos links enviados por e-mail
# (pesquisa de satisfação, convite). Ao compartilhar via túnel, use a URL dele.
SITE_URL=http://localhost:5174

# --- Anexos (D13) ---
MEDIA_ROOT=/var/lib/resolv/media
# Estes são PISO DE FALLBACK. O valor efetivo vive em Configurações → Operação
# (core.SystemConfig) e muda sem deploy. Confirmados: 20 MB, 10 arquivos.
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_FILES_PER_MESSAGE=10
# 20 MB × 10 = 200 MB por requisição. O nginx precisa acompanhar:
#   client_max_body_size 210m;
DATA_UPLOAD_MAX_MEMORY_SIZE=220200960

# --- Antivírus (D19): anexo fica em quarentena até a varredura liberar ---
# Desligar coloca todo anexo novo como "não verificado" e falha o
# `manage.py check --deploy`. Mantenha 1 fora de desenvolvimento.
# Antivírus dos anexos. O daemon é OPCIONAL (profile `antivirus` do compose e
# inexistente no modo nativo): com 1 e sem daemon, todo anexo sobe (201) e fica
# preso em quarentena para sempre — da tela, "anexo não funciona". Ligue só
# quando o ClamAV estiver de pé (`docker compose --profile antivirus up`).
# Em produção é obrigatório: `manage.py check --deploy` acusa se estiver em 0.
CLAMAV_ENABLED=0
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60
# 0 libera anexos cuja varredura falhou (fail-open) — só para janela de operação
ATTACHMENT_BLOCK_ON_SCAN_ERROR=1

# --- Retenção (D18/D20/D21) ---
# Prazo confirmado pelo negócio: 5 anos após o último fechamento do ticket.
# Com 1, a task diária das 03h30 apenas RELATA o que apagaria (RetentionRun).
# Para habilitar o expurgo:
#   1. manage.py retention_report            (simula e imprime)
#   2. manage.py retention_report --review   (registra que você conferiu)
#   3. RETENTION_DRY_RUN=0
RETENTION_DRY_RUN=1
# Trava: expurgo efetivo exige uma simulação revisada por uma pessoa.
# Desligar é escolha declarada, não default.
RETENTION_REQUIRE_REVIEWED_DRY_RUN=1

# --- Base de conhecimento (GAPS.md item 5) ---
# Cache local dos artigos da Central de Ajuda no WordPress. Desligado por
# padrão: confirme WORDPRESS_KB_POST_TYPE contra
# {WORDPRESS_KB_BASE_URL}/wp-json/wp/v2/types antes de ligar (ver docstring
# de apps/knowledge/services/wordpress_sync.py).
WORDPRESS_KB_ENABLED=0
WORDPRESS_KB_BASE_URL=https://convertizecombr.wpcomstaging.com
WORDPRESS_KB_POST_TYPE=suporte

# --- Backups (D21) ---
# Rotação das cópias de segurança. Apagar do banco não apaga dos backups: a
# exclusão se completa ao fim desta janela, e é este prazo que informamos ao
# titular. APÓS TODO RESTORE, rode `manage.py reapply_lgpd` — um restore desfaz
# anonimizações posteriores ao backup, silenciosamente.
# Backup diário às 23h, rotação de 30 dias (D21-B).
BACKUP_ROTATION_DAYS=30
